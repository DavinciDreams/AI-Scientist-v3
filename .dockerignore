# Keep Docker build context small for src/docker/agent-cli/Dockerfile.
# Assumption: current image builds do not need repo dotfiles or dot-directories.

# Ignore all dotfiles and dot-directories at any depth.
.*
**/.*

# Large/generated directories.
results/
__pycache__/
**/__pycache__/
.pytest_cache/
*.egg-info/
**/*.egg-info/

# Explicit keepers are not needed today because the Dockerfile copies nothing from the repo.
